# Copy these names into your shell or local .env tooling. Do not commit real secrets.
# TCP PostgreSQL URI (postgresql:// or postgres://), not a Supabase HTTPS URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Existing setting is preserved; not used by collect-one --source nowon.
SEOUL_API_KEY=sample

# NowonNewsNoticeList only. Supply your issued key locally for actual collection.
NOWON_NOTICE_API_KEY=sample

# Optional finite positive timeouts, in seconds (nan/inf/0 are rejected).
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
# Copy to .env in this directory and set a Gemini API key for local use.
# .env is ignored by Git. Never commit a real key.
# Merge note for feature/be/4-collect-notices: keep GEMINI_API_KEY alongside
# that branch's variable names when resolving .env.example; keep real keys local.
GEMINI_API_KEY=

# Default notice-glossary route: Gemini converts terms using GEMINI_API_KEY.
# --word uses OPENDICT_API_KEY and reuses saved definitions, including no results.
# ONTERM_API_KEY is only for the older dictionary-processing functions.
# API errors do not count as successful no-result lookups.
# Keep real keys in this directory's ignored .env or server environment only.
# OnTerm: https://kli.korean.go.kr/term/bbs/indexOpenApiInfo.do
# Ourmalsam: https://opendict.korean.go.kr/service/openApiRegister
ONTERM_API_KEY=
OPENDICT_API_KEY=

# Optional integration tests: export this separately when running pytest.
# Use an empty disposable loopback DB named pipeline_glossary_test_*.
# GLOSSARY_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/pipeline_glossary_test_local
