{
  "title": "쉬운말 본문 없음: 본문이 없는 공지는 Gemini를 부르지 않고 skipped로 보고한다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "new",
        "--easy-text"
      ],
      "gemini": {
        "easy_text": []
      },
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900501",
          "body": "input/nowon_page_900501.html"
        }
      ],
      "expect_exit": 0
    }
  ],
  "strict_unused": true
}
