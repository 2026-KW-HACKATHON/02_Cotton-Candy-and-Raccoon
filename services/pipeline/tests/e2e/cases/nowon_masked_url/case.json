{
  "title": "노원구 가려진 파일 주소: API 본문의 가려진 이미지 주소를 원문 페이지에서 복구해 저장한다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "new"
      ],
      "http": [
