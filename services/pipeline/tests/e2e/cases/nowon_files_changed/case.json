{
  "title": "노원구 첨부 변경: 원문 페이지의 첨부 목록이 바뀌면 파일 행이 교체되고 수정 표시된다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "new"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900421",
          "body": "input/nowon_page_before.html"
        }
      ],
      "expect_exit": 0
    },
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "refresh"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900421",
          "body": "input/nowon_page_after.html"
        }
      ],
      "expect_exit": 0
    }
  ],
  "strict_unused": true
}
