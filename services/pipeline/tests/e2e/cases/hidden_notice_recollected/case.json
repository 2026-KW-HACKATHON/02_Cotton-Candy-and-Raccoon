{
  "title": "숨긴 공지: 운영자가 숨긴 공지는 앱에 보이지 않고, 같은 응답으로 재수집했을 때의 현재 정책을 기록한다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "new"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900481",
          "body": "input/nowon_page_900481.html"
        }
      ],
      "expect_exit": 0
    },
    {
      "type": "sql",
      "reason": "운영자 숨김 기능이 코드에 없어 DB에서 직접 숨긴다",
      "sql": "update public.notices set is_visible = false where post_sn = '900481';"
    },
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "refresh"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900481",
          "body": "input/nowon_page_900481.html"
        }
      ],
      "expect_exit": 0
    }
  ],
  "strict_unused": true
}
