{
  "title": "노원구 --limit: 앞의 N건만 처리하고 limited, complete=false, exit 1로 보고한다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--limit",
        "1"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1000,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1,
          "body": "input/nowon_list_first.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900462",
          "body": "input/nowon_page_900462.html"
        }
      ],
      "expect_exit": 1
    }
  ],
  "strict_unused": true
}
