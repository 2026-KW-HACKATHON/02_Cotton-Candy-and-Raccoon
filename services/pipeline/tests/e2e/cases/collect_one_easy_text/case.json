      "sql": "create function e2e_reject_notice() returns trigger language plpgsql as $$ begin if new.post_sn = '900521' then raise exception 'e2e storage failure'; end if; return new; end $$; create trigger e2e_reject_notice before insert or update on public.notices for each row execute function e2e_reject_notice();"
