{
  "title": "노원구 collect-one과 쉬운말: 쉬운말이 실패하면 원문만 저장되고 exit 1이며, 다시 실행하면 쉬운말을 만든다. 저장이 실패하면 쉬운말을 실행하지 않고, 서울시는 --easy-text를 수집 전에 거부한다",
  "steps": [
    {
      "type": "collect-one",
      "args": [
        "--source",
        "nowon",
        "--easy-text"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1,
          "body": "input/nowon_list_one.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900521",
          "body": "input/nowon_page_900521.html"
        }
      ],
      "gemini": {
        "easy_text": [
          "input/easy_900521_error.json"
        ]
      },
      "expect_exit": 1
    },
    {
      "type": "collect-one",
      "args": [
        "--source",
        "nowon",
        "--easy-text"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1,
          "body": "input/nowon_list_one.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900521",
          "body": "input/nowon_page_900521.html"
        }
      ],
      "gemini": {
        "easy_text": [
          "input/easy_900521.json"
        ]
      },
      "expect_exit": 0
    },
    {
      "type": "sql",
      "reason": "DB 저장 실패를 재현하는 코드 경로가 없어 특정 게시물의 저장만 거부하는 트리거를 둔다",
      "sql": "create function e2e_reject_notice() returns trigger language plpgsql as $$ begin if new.post_sn = '900521' then raise exception 'e2e storage failure'; end if; return new; end $$; create trigger e2e_reject_notice before insert or update on public.notices for each row execute function e2e_reject_notice();"
    },
    {
      "type": "collect-one",
      "args": [
        "--source",
        "nowon",
        "--easy-text"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1,
          "body": "input/nowon_list_one.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900521",
          "body": "input/nowon_page_900521.html"
        }
      ],
      "gemini": {
        "easy_text": []
      },
      "expect_exit": 1
    },
    {
      "type": "collect-one",
      "args": [
        "--source",
        "seoul",
        "--easy-text"
      ],
      "expect_exit": 2
    },
    {
      "type": "collect",
      "args": [
        "--source",
        "seoul",
        "--mode",
        "new",
        "--easy-text"
      ],
      "expect_exit": 2
    }
  ],
  "strict_unused": true
}
