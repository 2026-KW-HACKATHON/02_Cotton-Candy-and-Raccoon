{
  "title": "노원구 일반 수집과 쉬운말: 저장에 실패한 공지는 쉬운말을 건너뛰고, 쉬운말 Gemini가 실패한 공지는 원문만 저장되며, 다음 공지는 계속 처리된다",
  "steps": [
    {
      "type": "sql",
      "reason": "DB 저장 실패를 재현하는 코드 경로가 없어 특정 게시물의 저장만 거부하는 트리거를 둔다",
      "sql": "create function e2e_reject_notice() returns trigger language plpgsql as $$ begin if new.post_sn = '900513' then raise exception 'e2e storage failure'; end if; return new; end $$; create trigger e2e_reject_notice before insert on public.notices for each row execute function e2e_reject_notice();"
    },
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--easy-text"
      ],
      "gemini": {
        "easy_text": [
          "input/easy_900512_error.json",
          "input/easy_900512_error.json",
          "input/rewrite_step_2_2.json"
        ]
      },
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1000,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_api",
          "start": 1,
          "end": 1,
          "body": "input/nowon_list_first.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900513",
          "body": "input/nowon_page_900513.html"
        },
        {
          "route": "nowon_page",
          "post_sn": "900512",
          "body": "input/nowon_page_900512.html"
        },
        {
          "route": "nowon_page",
          "post_sn": "900511",
          "body": "input/nowon_page_900511.html"
        }
      ],
      "expect_exit": 1
    }
  ],
  "strict_unused": true
}
