{
  "title": "노원구 원문 없음은 건너뛰고 실제 장애는 실패로 유지하며 기존 저장 공지를 보존한다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "new"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900443",
          "status": 503,
          "text": "Service Unavailable"
        },
        {
          "route": "nowon_page",
          "post_sn": "900443",
          "body": "input/nowon_page_900443.html"
        },
        {
          "route": "nowon_page",
          "post_sn": "900442",
          "body": "input/nowon_page_900442_missing.html"
        },
        {
          "route": "nowon_page",
          "post_sn": "900441",
          "body": "input/nowon_page_900441.html"
        }
      ],
      "expect_exit": 0
    },
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
