{
  "title": "노원구 본문 변경: 재수집하면 is_modified와 content_revision이 바뀌고, 이전 원문 기준 쉬운말은 앱에 보이지 않는다",
  "steps": [
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "new",
        "--easy-text"
      ],
      "gemini": {
        "easy_text": [
          "input/easy_900411.json"
        ]
      },
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list_before.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900411",
          "body": "input/nowon_page_900411.html"
        }
      ],
      "expect_exit": 0
    },
    {
      "type": "collect",
      "args": [
        "--source",
        "nowon",
        "--mode",
        "refresh"
      ],
      "http": [
        {
          "route": "nowon_api",
          "start": 1,
          "end": 50,
          "body": "input/nowon_list_after.xml"
        },
        {
          "route": "nowon_page",
          "post_sn": "900411",
          "body": "input/nowon_page_900411.html"
        }
      ],
      "expect_exit": 0
    }
  ],
  "strict_unused": true
}
